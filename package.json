{
  "name": "tournament-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run src/lib/services/__tests__/*.unit.test.ts",
    "test:integration": "vitest run src/lib/services/__tests__/*.integration.test.ts",
    "test:system": "vitest run src/app/api/**/__tests__/*.system.test.ts src/components/**/__tests__/*.system.test.ts",
    "test:watch": "vitest",
    "setup:local": "node src/scripts/setup-local.js",
    "supabase:start": "docker compose up -d",
    "supabase:stop": "docker compose down",
    "supabase:reset": "docker compose down -v && docker compose up -d",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "next-intl": "^4.16.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-624b8a5-20250421",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-sonarjs": "^4.2.3",
    "eslint-plugin-unicorn": "56",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  }
}
